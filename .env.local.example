# Copy to .env.local and fill in values from Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Vercel Cron auth for /api/cron/check-idle
CRON_SECRET=

# Cloudflare R2 — backup trước khi tự động tắt máy
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gpuvietnam-backups

# SSH vào máy Vast (private key PEM; dùng \n cho xuống dòng hoặc file path)
VAST_SSH_PRIVATE_KEY=
VAST_SSH_PRIVATE_KEY_PATH=

# GPU / Vast.ai (bắt buộc để bật máy từ Dashboard)
VAST_AI_KEY=
# Hoặc tên biến thay thế (docs Vast.ai dùng VAST_API_KEY)
# VAST_API_KEY=
# Image theo GPU line: v3 = 3090/4090 (supply), v4 = Studio/5090
# GPUVIETNAM_COMFYUI_IMAGE_V3=dieuhaukieuhanh/gpuvietnam-comfyui:v3
# Continuity hardening (empty-canvas guard): dieuhaukieuhanh/gpuvietnam-comfyui:v3.2
# Gate1 baseline: …:v3.1 — do not overwrite production :v3 unless promoting.
# GPUVIETNAM_COMFYUI_IMAGE_V4=dieuhaukieuhanh/gpuvietnam-comfyui:v4
# Legacy single-tag fallback (applies to v4 / DEFAULT only — không ép Starter/Pro):
# GPUVIETNAM_COMFYUI_IMAGE=dieuhaukieuhanh/gpuvietnam-comfyui:v4
# Rollback: ép một image cho mọi gói
# GPUVIETNAM_COMFYUI_IMAGE_FORCE=dieuhaukieuhanh/gpuvietnam-comfyui:v3
COMFYUI_PORT=8080
# GPU_REGIONS=Taiwan,Japan,Singapore
# true = chỉ Clore (tắt failover Vast) — dùng khi smoke/test Clore
# GPU_CLORE_ONLY=true
# Clore SSH gate (ms) — host chậm mở SSH: tăng nếu hay ECONNRESET / ssh timeout
# CLORE_SSH_READY_TIMEOUT_MS=120000
# CLORE_SSH_EXEC_ATTEMPT_MS=25000
# Clore HTTP fail-fast (ms) — đổi host sớm khi edge chết:
# Proxy Not Found default 90000; sustained 502 default 180000
# CLORE_PROXY_NOT_FOUND_FAIL_MS=90000
# CLORE_BAD_GATEWAY_FAIL_MS=180000
# Clore create_order: autossh + onstart Comfy bind (default true). Vast untouched.
# CLORE_AUTOSSH_ENTRYPOINT=true
# Clore bad-host exclusion TTL in days (default 30).
# CLORE_BAD_HOST_TTL_DAYS=30
# Ukraine + Iran permanently blocked for Clore and Vast rentals.
# Manual Clore verify:
#   npm run diag:clore-onstart -- --count=3          # product onstart, no SSH restart
#   npm run diag:clore-restart -- --count=3          # SSH restart protocol

# --- ComfyUI Level C reverse proxy (work.gpuvietnam.com) ---
# COMFY_PROXY_ENABLED=1
# COMFY_PROXY_BASE_URL=https://work.gpuvietnam.com
# COMFY_PROXY_SECRET=
# KV mirror (required while Next has no stable public origin; apex WP cannot resolve):
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# SCB Architecture Freeze v2 — Projection-first Read Path (default production architecture)
# unset or 1 = Projection-first (ON). Set =0 only for Legacy ADR-001 rollback.
SCB_READ_PROJECTION_FIRST=1

# MachineOperation worker — background recovery interval (ms). 0 disables. Primary path is enqueue kick.
SCB_MACHINE_OP_BACKGROUND_INTERVAL_MS=30000

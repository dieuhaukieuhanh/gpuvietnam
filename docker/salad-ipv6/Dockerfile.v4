# SaladCloud IPv6 dual-stack patch for v4 (5090)
# Extends existing v4.2 image — only overrides the start script.
FROM dieuhaukieuhanh/gpuvietnam-comfyui:v4.2

# Replace start.sh with IPv6 dual-stack version.
# Default: --listen :: (dual-stack, required by SaladCloud)
# Override: COMFYUI_LISTEN=0.0.0.0 (for Vast IPv4-only hosts)
COPY start-ipv6.sh /app/start.sh
RUN chmod +x /app/start.sh && \
    echo "[GPUVietnam] IPv6 dual-stack patch applied — default listen ::" > /app/salad-ipv6-patch.txt

[Unit]
Description=GPUVietnam P0-A Lifecycle Worker
Documentation=https://github.com/gpuvietnam/gpuvietnam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gpuvietnam
Group=gpuvietnam
WorkingDirectory=/opt/gpuvietnam
EnvironmentFile=-/etc/gpuvietnam/lifecycle.env
# Keep HOME/cache under ReadWritePaths (ProtectSystem=strict makes /opt RO otherwise).
Environment=HOME=/opt/gpuvietnam/tmp
Environment=XDG_CACHE_HOME=/opt/gpuvietnam/tmp/cache
Environment=TMPDIR=/tmp
# ──────── Provider routing ────────
# Start order SoT = Admin Hạ tầng (provider_routing_policy). Do NOT pin GPU_*_ONLY here
# unless break-glass. GPU_ALLOW_VAST keeps Vast usable when policy enables it.
Environment=GPU_ALLOW_VAST=true
Environment=GPUVIETNAM_LIFECYCLE_WORKER=1
# ──────── Image: v3.7 (3090/4090) + v4.4 (5090) ────────
Environment=GPUVIETNAM_COMFYUI_IMAGE_V3=dieuhaukieuhanh/gpuvietnam-comfyui:v3.7
Environment=GPUVIETNAM_COMFYUI_IMAGE_V4=dieuhaukieuhanh/gpuvietnam-comfyui:v4.4
# ──────── Public API URL (cho container gọi boot-event) ────────
Environment=GPUVIETNAM_PUBLIC_API_URL=https://gpuvietnam.com
# --experimental-strip-types: worker graph may import .ts helpers (e.g. @/lib/routes)
ExecStart=/usr/bin/node --experimental-strip-types --import ./scripts/register-src-alias.mjs scripts/lifecycle-worker.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# Hardening — worker writes only:
#   logs/          → file logger (cwd/logs)
#   tmp/           → host-reputation.json, clore-bad-hosts.json, vast-bad-hosts.json,
#                    provision-progress.json (cwd-relative)
#   PrivateTmp     → OS /tmp (no npm install at runtime; no Node package cache needed)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/gpuvietnam/logs /opt/gpuvietnam/tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target

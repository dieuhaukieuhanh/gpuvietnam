[Unit]
Description=GPUVietnam Host Intelligence Cron Timer — every 25 min
Requires=gpuvietnam-host-intel.service

[Timer]
OnBootSec=5min
# Fire after previous cycle finishes — avoids overlapping oneshot runs that SIGTERM mid-rent.
OnUnitInactiveSec=25min
RandomizedDelaySec=360
AccuracySec=30
Persistent=true

[Install]
WantedBy=timers.target

[Unit]
Description=GPUVietnam Host Intelligence Cron Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/gpuvietnam
ExecStart=/usr/bin/node --import ./scripts/register-src-alias.mjs scripts/host-intelligence-cron.mjs
Environment=NODE_ENV=production
Environment=HOME=/opt/gpuvietnam/tmp
Environment=XDG_CACHE_HOME=/opt/gpuvietnam/tmp/cache
Environment=TMPDIR=/tmp
EnvironmentFile=-/etc/gpuvietnam/lifecycle.env
Environment=GPUVIETNAM_PUBLIC_API_URL=https://gpuvietnam.com
StandardOutput=journal
StandardError=journal

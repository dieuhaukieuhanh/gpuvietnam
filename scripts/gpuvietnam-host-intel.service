[Unit]
Description=GPUVietnam Host Intelligence Cron Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/gpuvietnam
ExecStart=/usr/bin/node --import ./scripts/register-src-alias.mjs scripts/host-intelligence-cron.mjs
Environment=NODE_ENV=production
EnvironmentFile=/root/gpuvietnam/.env.production
StandardOutput=journal
StandardError=journal
